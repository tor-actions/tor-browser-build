@@ -1270,6 +1275,7 @@ void usage()
 	fprintf(stderr, "\t\tc=size (catalog b-tree)\n");
 	fprintf(stderr, "\t\ta=size (attributes b-tree)\n");
 	fprintf(stderr, "\t-v volume name (in ascii or UTF-8)\n");
