# vim: filetype=yaml sw=2
version: 0.10.0
git_url: https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird.git
git_hash: '[% c("version") %]'
tag_gpg_id: 1
gpg_keyring: anti-censorship.gpg

container:
  use_container: 1

var:
  go_vendor_sha256sum: e66b311c5fda698dcd9420a42d9c2f1cfc18e0d0ad9090bfb48904c7459534e2

targets:
  nightly:
    git_hash: main
    version: '[% c("abbrev") %]'
    tag_gpg_id: 0
  macos:
    var:
      pre_go_vendor: |
        if [ -e "/var/tmp/build/[% project %]-[% c('version') %]/go-1.22.patch" ]; then
          patch -p1 < "/var/tmp/build/[% project %]-[% c('version') %]/go-1.22.patch"
        fi
      go_vendor_sha256sum: 7ead3933bccf9a239b49ad16234a9e9ed17558af2362e81de1c723c272170fcb

steps:
  build:
    filename: '[% project %]-[% c("version") %]-[% c("var/osname") %]-[% c("var/build_id") %].tar.[% c("compress_tar") %]'
    input_files:
      - project: container-image
      - name: go
        project: go
      - name: '[% c("var/compiler") %]'
        project: '[% c("var/compiler") %]'
        enable: '[% c("var/android") %]'
      - name: go_vendor
        pkg_type: go_vendor
        project: lyrebird
        norec:
          sha256sum: '[% IF !c("var/nightly") %][% c("var/go_vendor_sha256sum") %][% END %]'
      - name: go-licenses
        project: go-licenses
        target_replace:
          '^torbrowser-(?!testbuild).*': 'torbrowser-linux-x86_64'
