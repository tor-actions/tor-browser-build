# vim: filetype=yaml sw=2
# To update, see doc/how-to-update-the-manual.txt
# Remember to update also the package's hash, with the version!
version: 416594
filename: 'manual-[% c("version") %]-[% c("var/build_id") %].tar.[% c("compress_tar") %]'
container:
  use_container: 1

# Linux builds still use gz as compress_tar, while other platforms use
# zst. To avoid duplicating manual tarballs which can be shared
# between platforms, we set compress_tar.
compress_tar: 'gz'

var:
  container:
    suite: bookworm
    arch: amd64
  deps:
    - python3
  pre_pkginst: ''

input_files:
  - project: container-image
  - URL: 'https://build-sources.tbb.torproject.org/marble-support_[% c("version") %].zip'
    name: manual
    sha256sum: c46e32fadaa12c0d5c03738e219b03c18131d755deff8c95dae87de382907402
  - filename: package_marble_build_artifacts.py
    name: package_script
