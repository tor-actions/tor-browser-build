# vim: filetype=yaml sw=2
filename: 'container-image_[% c("var/container/suite") %]-[% c("var/container/arch") %]-[% c("version") %].tar.[% c("compress_tar") %]'
version: 2
pkg_type: build
compress_tar: zst
container:
  use_container: 1

var:
  ubuntu_version: 24.04.5

pre: |
  #!/bin/sh
  set -e
  rootdir=$(pwd)
  export DEBIAN_FRONTEND=noninteractive

  # Install critical apt security update before using it:
  # https://lists.debian.org/deity/2026/11/msg00005.html
  # We can remove this when a new Ubuntu image containing the fixed
  # package is available
  dpkg -i libapt-pkg6.0t64_2.8.4ubuntu0.1_amd64.deb apt_2.8.4ubuntu0.1_amd64.deb

  apt-get update -y -q
  apt-get install -y -q debian-archive-keyring ubuntu-keyring mmdebstrap gnupg zstd

  export SOURCE_DATE_EPOCH='[% c("timestamp") %]'
  tar -xf [% c('input_files_by_name/mmdebstrap') %]
  ./mmdebstrap/mmdebstrap --mode=unshare [% c("var/container/mmdebstrap_opt") %] [% c("var/container/suite") %] output.tar.[% c('compress_tar') %] [% c("var/container/debian_mirror") %]

  [% IF c("var/minimal_apt_version") -%]
    mkdir base-image
    tar -C base-image -xf output.tar.[% c('compress_tar') %] ./var/lib/dpkg
    apt_version=$(dpkg --admindir=$rootdir/base-image/var/lib/dpkg -s apt | grep '^Version: ' | cut -d ' ' -f 2)
    echo "apt version: $apt_version"
    dpkg --compare-versions "$apt_version" ge '[% c("var/minimal_apt_version") %]'
  [% END -%]

  mv output.tar.[% c('compress_tar') %] [% dest_dir %]/[% c("filename") %]

targets:
  stretch-amd64:
    var:
      minimal_apt_version: 1.4.11
      container:
        suite: stretch
        arch: amd64
        mmdebstrap_opt: --include=apt-transport-https,ca-certificates
        debian_mirror: >
          "deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://archive.debian.org/debian-archive/debian/ stretch main"
          "deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://archive.debian.org/debian-archive/debian-security/ stretch/updates main"

  bookworm-amd64:
    var:
      minimal_apt_version: 2.6.2
      container:
        suite: bookworm
        arch: amd64

  trixie-amd64:
    var:
      minimal_apt_version: 3.0.4
      container:
        suite: trixie
        arch: amd64

input_files:
  - project: mmdebstrap
    name: mmdebstrap
  - URL: 'https://cdimage.ubuntu.com/ubuntu-base/releases/[% c("var/ubuntu_version") %]/release/ubuntu-base-[% c("var/ubuntu_version") %]-base-amd64.tar.gz'
    filename: 'container-image_ubuntu-base-[% c("var/ubuntu_version") %]-base-amd64.tar.gz'
    sha256sum: e77b6f10c2590cef872b33ee9f635a0e3fd1f57fb074c0e52b5c7f56147a0c86
    # https://packages.ubuntu.com/noble/amd64/apt/download
  - URL: http://security.ubuntu.com/ubuntu/pool/main/a/apt/apt_2.8.4ubuntu0.1_amd64.deb
    sha256sum: ad2ea7f107f250ba88b0bfdba31812a341e3247589647aa2b03b9dc4e8abf8ed
    # https://packages.ubuntu.com/noble/libapt-pkg6.0t64
  - URL: http://security.ubuntu.com/ubuntu/pool/main/a/apt/libapt-pkg6.0t64_2.8.4ubuntu0.1_amd64.deb
    sha256sum: a50f3e68a793f90b05f44a4b5f2f59f3ec7687e39b5d8bbd1da44c84671fa3d6
