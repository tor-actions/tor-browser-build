#!/bin/bash
[% c("var/set_default_env") -%]

tar -xf [% project %]-[% c("version") %].tar.[% c('compress_tar') %] \
  [% project %]-[% c("version") %]/conf/builtin.json \
  [% project %]-[% c("version") %]/conf/circumvention.json
jq 'del(.["meek-azure"])'  [% project %]-[% c("version") %]/conf/builtin.json > builtin.json
jq -c keys [% project %]-[% c("version") %]/conf/circumvention.json > moat_countries.json

[% c("touch") %] builtin.json
[% c("touch") %] moat_countries.json
[% c('tar', {
    tar_src => 'builtin.json moat_countries.json',
    tar_args => '-caf ' _ dest_dir _ '/' _ c('filename'),
  }) %]
