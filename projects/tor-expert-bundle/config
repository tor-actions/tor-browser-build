# vim: filetype=yaml sw=2
filename: '[% project %]-[% c("var/osname") %]-[% c("var/build_id") %]'
version: '[% c("var/torbrowser_version") %]'

var:
  recommended_transport: obfs4

input_files:
  - name: tor
    project: tor
  - name: lyrebird
    project: lyrebird
  - name: conjure
    project: conjure
    enable: '[% !c("var/android-x86_64") %]'
  - filename: make_pt_config.py
  - filename: transports.json
  - name: moat-settings
    project: moat-settings
  - filename: torrc-defaults
    enable: '[% !c("var/android") %]'
  - filename: AndroidManifest.xml
    enable: '[% c("var/android") %]'
  - filename: MANIFEST.MF
    enable: '[% c("var/android") %]'
